{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ObolNetwork/obol-sdk/spec/schemas/cluster.lock.json",
  "title": "cluster.lock",
  "properties": {
    "cluster_definition": {
      "properties": {
        "compounding": {
          "type": "boolean"
        },
        "config_hash": {
          "type": "string"
        },
        "consensus_protocol": {
          "type": "string"
        },
        "creator": {
          "properties": {
            "address": {
              "type": "string"
            },
            "config_signature": {
              "type": "string"
            }
          },
          "required": [
            "address"
          ],
          "type": "object"
        },
        "definition_hash": {
          "type": "string"
        },
        "deposit_amounts": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "minimum": 0,
                    "type": "integer"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "dkg_algorithm": {
          "type": "string"
        },
        "fork_version": {
          "description": "fork version (4 bytes)",
          "pattern": "^0x[0-9a-fA-F]{8}$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "num_validators": {
          "minimum": 0,
          "type": "integer"
        },
        "operators": {
          "anyOf": [
            {
              "items": {
                "properties": {
                  "address": {
                    "type": "string"
                  },
                  "config_signature": {
                    "type": "string"
                  },
                  "enr": {
                    "type": "string"
                  },
                  "enr_signature": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_gas_limit": {
          "minimum": 0,
          "type": "integer"
        },
        "threshold": {
          "minimum": 0,
          "type": "integer"
        },
        "timestamp": {
          "type": "string"
        },
        "uuid": {
          "type": "string"
        },
        "validators": {
          "anyOf": [
            {
              "items": {
                "properties": {
                  "fee_recipient_address": {
                    "type": "string"
                  },
                  "withdrawal_address": {
                    "type": "string"
                  }
                },
                "required": [
                  "fee_recipient_address",
                  "withdrawal_address"
                ],
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "num_validators",
        "threshold",
        "fork_version",
        "config_hash",
        "creator",
        "operators",
        "validators"
      ],
      "type": "object"
    },
    "distributed_validators": {
      "items": {
        "properties": {
          "builder_registration": {
            "properties": {
              "message": {
                "properties": {
                  "fee_recipient": {
                    "type": "string"
                  },
                  "gas_limit": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "pubkey": {
                    "type": "string"
                  },
                  "timestamp": {
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "fee_recipient",
                  "gas_limit",
                  "timestamp",
                  "pubkey"
                ],
                "type": "object"
              },
              "signature": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "signature"
            ],
            "type": "object"
          },
          "deposit_data": {
            "properties": {
              "amount": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "minimum": 0,
                    "type": "integer"
                  }
                ]
              },
              "deposit_data_root": {
                "type": "string"
              },
              "pubkey": {
                "type": "string"
              },
              "signature": {
                "type": "string"
              },
              "withdrawal_credentials": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "distributed_public_key": {
            "type": "string"
          },
          "partial_deposit_data": {
            "anyOf": [
              {
                "items": {
                  "properties": {
                    "amount": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "minimum": 0,
                          "type": "integer"
                        }
                      ]
                    },
                    "deposit_data_root": {
                      "type": "string"
                    },
                    "pubkey": {
                      "type": "string"
                    },
                    "signature": {
                      "type": "string"
                    },
                    "withdrawal_credentials": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "public_shares": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "distributed_public_key",
          "public_shares"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "lock_hash": {
      "type": "string"
    },
    "node_signatures": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "signature_aggregate": {
      "type": "string"
    }
  },
  "required": [
    "cluster_definition",
    "distributed_validators",
    "signature_aggregate",
    "lock_hash"
  ],
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ObolNetwork/obol-sdk/spec/schemas/simulate.options.json",
  "title": "simulate.options",
  "additionalProperties": false,
  "properties": {
    "backend": {
      "anyOf": [
        {
          "const": "auto",
          "type": "string"
        },
        {
          "const": "eth_simulateV1",
          "type": "string"
        },
        {
          "const": "debug_traceCall",
          "type": "string"
        },
        {
          "const": "eth_call",
          "type": "string"
        }
      ]
    },
    "blockNumber": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "x-obol-type": "bigint",
          "x-obol-minimum": "0"
        },
        {
          "const": "latest",
          "type": "string"
        }
      ]
    },
    "from": {
      "description": "Address: all-lowercase, all-uppercase or valid EIP-55 checksum",
      "format": "obol-address",
      "type": "string"
    }
  },
  "type": "object"
}

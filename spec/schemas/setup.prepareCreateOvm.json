{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ObolNetwork/obol-sdk/spec/schemas/setup.prepareCreateOvm.json",
  "title": "setup.prepareCreateOvm",
  "additionalProperties": false,
  "properties": {
    "owner": {
      "description": "Address: all-lowercase, all-uppercase or valid EIP-55 checksum",
      "format": "obol-address",
      "type": "string"
    },
    "principalRecipient": {
      "description": "Address: all-lowercase, all-uppercase or valid EIP-55 checksum",
      "format": "obol-address",
      "type": "string"
    },
    "principalThreshold": {
      "description": "wei",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-obol-type": "bigint",
      "x-obol-minimum": "0"
    },
    "rewardRecipient": {
      "description": "Address: all-lowercase, all-uppercase or valid EIP-55 checksum",
      "format": "obol-address",
      "type": "string"
    }
  },
  "required": [
    "owner",
    "principalRecipient",
    "rewardRecipient"
  ],
  "type": "object"
}

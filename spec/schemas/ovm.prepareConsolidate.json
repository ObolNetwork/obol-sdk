{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ObolNetwork/obol-sdk/spec/schemas/ovm.prepareConsolidate.json",
  "title": "ovm.prepareConsolidate",
  "additionalProperties": false,
  "properties": {
    "acknowledgeStakeMovesToTarget": {
      "const": true,
      "type": "boolean"
    },
    "beaconUrl": {
      "minLength": 1,
      "type": "string"
    },
    "excessFeeRecipient": {
      "description": "Address: all-lowercase, all-uppercase or valid EIP-55 checksum",
      "format": "obol-address",
      "type": "string"
    },
    "fee": {
      "description": "wei",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-obol-type": "bigint",
      "x-obol-minimum": "0"
    },
    "from": {
      "description": "Address: all-lowercase, all-uppercase or valid EIP-55 checksum",
      "format": "obol-address",
      "type": "string"
    },
    "lockHash": {
      "description": "32-byte hex",
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "type": "string"
    },
    "ovm": {
      "description": "Address: all-lowercase, all-uppercase or valid EIP-55 checksum",
      "format": "obol-address",
      "type": "string"
    },
    "pendingRetry": {
      "additionalProperties": false,
      "properties": {
        "delayMs": {
          "maximum": 60000,
          "minimum": 0,
          "type": "integer"
        },
        "tries": {
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "requests": {
      "items": {
        "properties": {
          "sources": {
            "items": {
              "description": "BLS public key (48 bytes)",
              "pattern": "^0x[0-9a-fA-F]{96}$",
              "type": "string"
            },
            "maxItems": 63,
            "minItems": 1,
            "type": "array"
          },
          "target": {
            "description": "BLS public key (48 bytes)",
            "pattern": "^0x[0-9a-fA-F]{96}$",
            "type": "string"
          }
        },
        "required": [
          "sources",
          "target"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "ovm",
    "requests",
    "acknowledgeStakeMovesToTarget"
  ],
  "type": "object"
}

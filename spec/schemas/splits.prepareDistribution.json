        "allocations": {
          "items": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$",
                "x-obol-type": "bigint",
                "x-obol-minimum": "0"
              },
              {
                "maximum": 9007199254740991,

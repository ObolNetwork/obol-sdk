{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ObolNetwork/obol-sdk/spec/schemas/splits.prepareDistribution.json",
  "title": "splits.prepareDistribution",
  "additionalProperties": false,
  "properties": {
    "distributor": {
      "description": "Address: all-lowercase, all-uppercase or valid EIP-55 checksum",
      "format": "obol-address",
      "type": "string"
    },
    "from": {
      "description": "Address: all-lowercase, all-uppercase or valid EIP-55 checksum",
      "format": "obol-address",
      "type": "string"
    },
    "includeRaf": {
      "type": "boolean"
    },
    "minWithdraw": {

      "pattern": "^(0|[1-9][0-9]*)$",
      "x-obol-type": "bigint",
      "x-obol-minimum": "1"
    },
    "ovm": {
      "description": "Address: all-lowercase, all-uppercase or valid EIP-55 checksum",
      "format": "obol-address",
      "type": "string"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ObolNetwork/obol-sdk/spec/schemas/splits.getSplit.json",
  "title": "splits.getSplit",
  "additionalProperties": false,
  "properties": {
    "address": {
      "description": "Address: all-lowercase, all-uppercase or valid EIP-55 checksum",
      "format": "obol-address",
      "type": "string"
    },
    "ovm": {
      "description": "Address: all-lowercase, all-uppercase or valid EIP-55 checksum",
      "format": "obol-address",
      "type": "string"
    },
    "params": {
      "properties": {
        "allocations": {
          "items": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$",
                "x-obol-type": "bigint",
                "x-obol-minimum": "0"
              },
              {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              }
            ]
          },
          "minItems": 1,
          "type": "array"
        },
        "distributionIncentive": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "recipients": {
          "items": {
            "description": "Address: all-lowercase, all-uppercase or valid EIP-55 checksum",
            "format": "obol-address",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "totalAllocation": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "x-obol-type": "bigint",
              "x-obol-minimum": "0"
            },
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          ]
        }
      },
      "required": [
        "recipients",
        "allocations",
        "totalAllocation",
        "distributionIncentive"
      ],
      "type": "object"
    }
  },
  "required": [
    "address"
  ],
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ObolNetwork/obol-sdk/spec/schemas/deposits.fromLock.options.json",
  "title": "deposits.fromLock.options",
  "properties": {
    "amount": {
      "description": "wei",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-obol-type": "bigint",
      "x-obol-minimum": "0"
    },
    "chainId": {
      "minimum": 0,
      "type": "integer"
    },
    "validators": {
      "items": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "description": "BLS public key (48 bytes)",
            "pattern": "^0x[0-9a-fA-F]{96}$",
            "type": "string"
          }
        ]
      },
      "minItems": 1,
      "type": "array"
    },
    "verify": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "const": "attested",
          "type": "string"
        },
        {
          "const": "full",
          "type": "string"
        }
      ]
    },
    "yieldMs": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ObolNetwork/obol-sdk/spec/schemas/setup.prepareOvmWithSplits.json",
  "title": "setup.prepareOvmWithSplits",
  "additionalProperties": false,
  "properties": {
    "owner": {
      "description": "Address: all-lowercase, all-uppercase or valid EIP-55 checksum",
      "format": "obol-address",
      "type": "string"
    },
    "principal": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "description": "Address: all-lowercase, all-uppercase or valid EIP-55 checksum",
          "format": "obol-address",
          "type": "string"
        },
        "split": {
          "additionalProperties": false,
          "properties": {
            "distributionIncentive": {
              "description": "ppm, integer in [0, 65535]"
            },
            "owner": {
              "description": "Address: all-lowercase, all-uppercase or valid EIP-55 checksum",
              "format": "obol-address",
              "type": "string"
            },
            "recipients": {
              "description": "array of { address, share }: shares in ppm (bigint or safe integer), summing to 1000000"
            },
            "salt": {
              "description": "32-byte hex",
              "pattern": "^0x[0-9a-fA-F]{64}$",
              "type": "string"
            }
          },
          "required": [
            "recipients"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "principalThreshold": {
      "description": "wei",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-obol-type": "bigint",
      "x-obol-minimum": "0"
    },
    "reward": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "description": "Address: all-lowercase, all-uppercase or valid EIP-55 checksum",
          "format": "obol-address",
          "type": "string"
        },
        "split": {
          "additionalProperties": false,
          "properties": {
            "distributionIncentive": {
              "description": "ppm, integer in [0, 65535]"
            },
            "owner": {
              "description": "Address: all-lowercase, all-uppercase or valid EIP-55 checksum",
              "format": "obol-address",
              "type": "string"
            },
            "recipients": {
              "description": "array of { address, share }: shares in ppm (bigint or safe integer), summing to 1000000"
            },
            "salt": {
              "description": "32-byte hex",
              "pattern": "^0x[0-9a-fA-F]{64}$",
              "type": "string"
            }
          },
          "required": [
            "recipients"
          ],
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "owner",
    "reward",
    "principal"
  ],
  "type": "object"
}

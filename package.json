{
  "name": "@obolnetwork/obol-sdk",
  "version": "3.0.0-rc.3",
  "description": "TypeScript SDK for creating and managing Obol Distributed Validators, built on viem.",
  "bugs": {
    "url": "https://github.com/obolnetwork/obol-sdk/issues"
  },
  "homepage": "https://docs.obol.org/",
  "keywords": [
    "Obol",
    "Distributed Validators",
    "Ethereum",
    "viem"
  ],
  "scripts": {
    "build:clean": "rm -rf ./dist",
    "build": "npm-run-all build:clean build:tsup",
    "build:tsup": "tsup && tsc -b ./tsconfig.types.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern='/test/.*\\.spec\\.ts$'",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.e2e.config.cjs --runInBand",
    "generate-typedoc": "typedoc",
    "npm:publish": "npm publish --tag latest",
    "npm:publish:next": "npm publish --tag next",
    "release": "release-it",
    "release:dry": "release-it --dry-run --no-npm",
    "lint": "eslint ./src --ext .ts,.js --fix",
    "lint-ci": "eslint ./src --ext .ts,.js",
    "prettier-ci": "prettier --check ./src --ext .ts,.js",
    "prettier": "prettier --write \"src/**/*.{js,ts}\"",
    "docs": "typedoc"
  },
  "main": "./dist/cjs/src/index.js",
  "module": "./dist/esm/src/index.js",
  "browser": "./dist/browser/src/index.js",
  "typings": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "browser": {
        "import": "./dist/browser/src/index.js",
        "default": "./dist/browser/src/index.js"
      },
      "node": {
        "import": "./dist/esm/src/index.js",
        "require": "./dist/cjs/src/index.js"
      },
      "default": "./dist/esm/src/index.js"
    }
  },
  "author": "Obol Labs (https://obol.org)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ObolNetwork/obol-sdk"
  },
  "license": "ISC",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "//": [
    "PINNING NOTES:",
    "@chainsafe/ssz MUST stay at ^0.14.x — v0.15+ set type:module (ESM-only), same CJS constraint.",
    "@typescript-eslint/* stays at ^6.x — eslint-config-standard-with-typescript@43 requires plugin ^6; v8 causes peer conflict.",
    "@noble/curves replaces @chainsafe/bls — pure-JS CJS+ESM, no native addon, same ETH2 BLS12-381 spec. See CHAINSAFE_MIGRATION_PLAN.md.",
    "@noble/curves is in devDependencies (not dependencies) because tsup bundles it inline via noExternal. Keeping it in dependencies caused consumers to install @noble/hashes@2.2.0 (major-version 2) which shadowed @noble/hashes@1.x used by ethereum-cryptography, @coinbase/wallet-sdk, etc., breaking their @noble/curves initialisation with 'anumber is not a function'.",
    "viem is a peer dependency (the caller brings its own clients) and a devDependency for tests.",
    "@chainsafe/blst (native) is a devDependency for tests only: it cross-checks the pure-JS BLS backend. The SDK never imports it; callers may pass an adapter over it (cluster.BlsBackend)."
  ],
  "resolutions": {
    "ws": "^8.21.0",
    "undici": "^6.24.0",
    "**/@typescript-eslint/typescript-estree/minimatch": "^9.0.7",
    "basic-ftp": "6.2.2"
  },
  "dependencies": {
    "@chainsafe/enr": "6.0.1",
    "@chainsafe/ssz": "0.14.3",
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "@chainsafe/blst": "2.2.0",
    "@noble/curves": "2.2.0",
    "@release-it/conventional-changelog": "11.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.12.2",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.1",
    "eslint-config-standard-with-typescript": "43.0.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-promise": "7.3.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "16.4.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.8.3",
    "release-it": "19.2.4",
    "ts-jest": "29.4.9",
    "tsup": "8.5.1",
    "typedoc": "0.28.19",
    "typedoc-plugin-markdown": "4.11.0",
    "typescript": "5.9.3",
    "viem": "2.57.3"
  },
  "engines": {
    "node": ">= 20"
  },
  "files": [
    "package.json",
    "README.md",
    "dist"
  ],
  "release-it": {
    "git": {
      "changelog": "npx auto-changelog --stdout --commit-limit false --unreleased --template https://raw.githubusercontent.com/release-it/release-it/main/templates/changelog-compact.hbs",
      "commitMessage": "chore(release): v${version}",
      "push": true,
      "commit": true,
      "tag": true,
      "requireCommits": false,
      "requireCleanWorkingDir": false
    },
    "github": {
      "release": true,
      "draft": true
    },
    "npm": {
      "publish": false,
      "ignoreVersion": false
    },
    "hooks": {
      "after:bump": "npx auto-changelog -p --hide-credit"
    }
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "module": "esnext",
            "target": "es2020",
            "moduleResolution": "node"
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.\\.?\\/.+)\\.js$": "$1",
      "^(\\.\\.?\\/.+)$": "$1"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@chainsafe)/)"
    ],
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "<rootDir>/dist/",
      "<rootDir>/node_modules/"
    ],
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "maxWorkers": "50%"
  },
  "packageManager": "yarn@1.22.22",
  "peerDependencies": {
    "viem": "^2.21.0"
  }
}
